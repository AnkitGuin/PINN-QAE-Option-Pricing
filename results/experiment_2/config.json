{
  "calibration": {
    "frozen": {
      "description": "least-squares fit on the FIRST calibration window only, never updated"
    },
    "ls": {
      "max_evaluations": 200,
      "method": "bounded_scalar",
      "warm_start": true,
      "x_tolerance": 1e-10
    },
    "references": [
      "sigma_instantaneous",
      "sigma_effective_block"
    ],
    "rolling": {
      "horizon_dates": 5,
      "min_window_observations": 30,
      "step_dates": 5,
      "window_dates": 20
    },
    "sigma_bounds": [
      0.01,
      3.0
    ]
  },
  "exp2": {
    "conditions": [
      {
        "name": "constant_clean",
        "scenario": "synthetic/constant.yaml"
      },
      {
        "name": "constant_noise",
        "overrides": {
          "synthetic": {
            "noise": {
              "mode": "relative_gaussian",
              "relative_std": 0.02
            }
          }
        },
        "scenario": "synthetic/constant.yaml"
      },
      {
        "name": "constant_sparse",
        "overrides": {
          "synthetic": {
            "maturities": [
              0.25,
              0.5,
              1.0
            ],
            "moneyness": {
              "max": 1.1,
              "min": 0.9,
              "n": 5
            }
          }
        },
        "scenario": "synthetic/constant.yaml"
      },
      {
        "name": "constant_noise_sparse",
        "scenario": "synthetic/noise_sparse.yaml"
      },
      {
        "name": "gradual_change",
        "scenario": "synthetic/gradual_change.yaml"
      },
      {
        "name": "abrupt_change",
        "scenario": "synthetic/abrupt_change.yaml"
      }
    ],
    "gates": {
      "constant_recovery_abs_tol": 0.02
    },
    "methods": [
      "least_squares",
      "pinn",
      "frozen",
      "data_only_nn"
    ],
    "reference_price": "true_price",
    "seeds": [
      0,
      1,
      2,
      3,
      4
    ]
  },
  "experiment": {
    "description": "Core experiment: rolling inverse-PINN volatility calibration vs rolling constrained least squares vs frozen calibration vs data-only NN under identical walk-forward windows, on synthetic scenarios with known ground truth.",
    "id": "experiment_2",
    "name": "exp2_inverse_pinn",
    "output_dir": "results/experiment_2"
  },
  "logging": {
    "level": "INFO"
  },
  "metrics": {
    "price_floor_epsilon": 0.05
  },
  "paths": {
    "data_dir": "data",
    "figures_dir": "figures",
    "logs_dir": "logs",
    "results_dir": "results"
  },
  "pinn": {
    "architecture": {
      "activation": "tanh",
      "hidden_units": [
        32,
        32,
        32
      ],
      "input_features": [
        "log_moneyness",
        "tau",
        "rate"
      ]
    },
    "data_only": {
      "use_boundary": false,
      "use_pde": false,
      "use_terminal": false
    },
    "loss_weights": {
      "lambda_boundary": 1.0,
      "lambda_data": 1.0,
      "lambda_pde": 100.0,
      "lambda_terminal": 5.0
    },
    "normalization": {
      "notes": "homogeneous coordinates; V = S * u(log(S/K), tau, r)",
      "price_scale": null
    },
    "pde_residual_scaling": "homogeneous_dimensionless",
    "sigma_parameterization": {
      "epsilon_sigma": 1e-06,
      "init_sigma": 0.2,
      "warm_start": true
    },
    "training": {
      "collocation": {
        "n_boundary": 256,
        "n_interior": 512,
        "n_terminal": 256,
        "s_high_factor": 2.4,
        "s_low_factor": 0.3,
        "tau_min": 0.05,
        "terminal_smoothing_alpha": 0.0
      },
      "early_stopping": {
        "enabled": true,
        "min_delta": 1e-09,
        "patience": 300
      },
      "refinement": {
        "iterations": 350,
        "lr": 0.5,
        "tolerance": 1e-16
      },
      "stage_a": {
        "epochs": 900,
        "lr": 0.005,
        "lr_decay": 0.9995
      },
      "stage_b": {
        "epochs": 400,
        "lbfgs_iterations": 350,
        "lbfgs_lr": 0.3,
        "lr_net": 0.001,
        "lr_sigma": 0.003
      },
      "torch_threads": 1,
      "validation_fraction": 0.15
    }
  },
  "project": {
    "device": "cpu",
    "master_seed": 42,
    "name": "pinn-qae-option-pricing",
    "title": "Physics-Informed Neural Networks for Adaptive Quantum Option Pricing under Time-Varying Market Conditions"
  },
  "reproducibility": {
    "record_environment": true
  }
}